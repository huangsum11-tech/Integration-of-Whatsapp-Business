# Baton 設定範本：複製成 .env（與這個檔案同一個資料夾），填入你的值。
# .env 已列入 .gitignore，不會上傳到 GitHub。不要把真實金鑰寫進 .env.example。

# ---------- 伺服器 ----------
PORT=4000
# 資料庫、WhatsApp 登入資料、媒體檔案、知識庫都放在這個資料夾，請定期備份
# BATON_DATA_DIR=/path/to/data   （預設：server/data）
# 正式（HTTPS）部署時設為 production
# NODE_ENV=production

# ---------- AI（填你要用的那一個或幾個；在網頁「AI 助手」頁選用哪一個） ----------
# Claude：https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini：https://aistudio.google.com （填了就會自動把客人語音訊息轉成文字）
GEMINI_API_KEY=
# Grok：https://console.x.ai
XAI_API_KEY=
# 客人停止打字多少毫秒後才自動回覆
BATON_AI_DELAY_MS=8000

# ---------- Meta 官方 API（WhatsApp Cloud API／Instagram） ----------
# 自己定一串字，在 Meta App 設定 Webhook 時「驗證權杖」填同一串
META_VERIFY_TOKEN=
# Meta App → 設定 → 基本資料 → 應用程式密鑰（用來驗證 webhook 是 Meta 發出）
META_APP_SECRET=
# Instagram 產品如有另一個 App 密鑰，填這裏
INSTAGRAM_APP_SECRET=
# META_GRAPH_VERSION=v25.0
# 多久讀取一次 Threads 留言（毫秒）
# BATON_THREADS_POLL_MS=180000

# ---------- 導師糧單 ----------
# 排程及月底提醒用的時區
# BATON_TZ=Asia/Hong_Kong
# 每份糧單之間相隔多少毫秒
# BATON_PAYROLL_GAP_MS=3000

# ---------- 群發 ----------
# 每條訊息之間大約相隔多少毫秒（QR 號碼建議不要調低）
# BATON_BROADCAST_GAP_MS=10000
